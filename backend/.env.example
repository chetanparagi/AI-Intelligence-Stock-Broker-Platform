# Local demo only. Never commit the real .env file.
APP_ENV=development
DATABASE_URL=sqlite:///./zerodha-demo.db
GROQ_API_KEY=
# Fast plain-text model used for portfolio-only questions (no web access).
GROQ_MODEL=llama-3.3-70b-versatile
# Groq Compound model used for market/news questions; it can call Groq's built-in
# web search and returns citations. Use groq/compound-mini for lower latency.
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
# Per-ticker cache duration. GLOBAL_QUOTE is end-of-day by default for global symbols.
ALPHA_VANTAGE_CACHE_SECONDS=900
# Free plan default: 25 API calls/day; raise only if your plan allows it.
ALPHA_VANTAGE_DAILY_LIMIT=25
# Free plan throttle: 5 calls/minute. Change only if your Alpha Vantage plan permits it.
ALPHA_VANTAGE_MIN_INTERVAL_SECONDS=12.1
